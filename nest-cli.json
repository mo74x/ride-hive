{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/ride-hive/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/ride-hive/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/ride-hive",
  "projects": {
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "dispatch": {
      "type": "application",
      "root": "apps/dispatch",
      "entryFile": "main",
      "sourceRoot": "apps/dispatch/src",
      "compilerOptions": {
        "tsConfigPath": "apps/dispatch/tsconfig.app.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "ingestion": {
      "type": "application",
      "root": "apps/ingestion",
      "entryFile": "main",
      "sourceRoot": "apps/ingestion/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ingestion/tsconfig.app.json"
      }
    },
    "ride-hive": {
      "type": "application",
      "root": "apps/ride-hive",
      "entryFile": "main",
      "sourceRoot": "apps/ride-hive/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ride-hive/tsconfig.app.json"
      }
    }
  }
}